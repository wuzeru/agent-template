# ============ 自定义 OpenAI 兼容端点（方舟、Moonshot、DeepSeek…） ============
# PI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# PI_MODEL=doubao-seed-2-0-lite-260215
# PI_API_KEY=你的 API Key

# ============ 或使用 pi-ai 内置模型 ============
# PI_PROVIDER=openai
# PI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-xxx
#
# 其他厂商密钥见 https://github.com/badlogic/pi-mono/tree/main/packages/ai
